  </main>

  <!-- Password Toggle -->
  <script>
  function togglePassword(inputId, btn) {
    var input = document.getElementById(inputId);
    if (!input) return;
    var isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
  }
  </script>

  <!-- Gallery Lightbox -->
  <script>
  function openLightbox(src) {
    var overlay = document.createElement('div');
    overlay.className = 'gallery-lightbox';
    overlay.innerHTML = '<button class="gallery-lightbox-close">&times;</button><img src="' + src + '" alt="">';
    overlay.addEventListener('click', function(e) { if (e.target !== overlay.querySelector('img')) overlay.remove(); });
    document.body.appendChild(overlay);
  }
  </script>

  <!-- Toast Notification Container (Phase 3) -->
  <div class="toast-container" id="toast-container" role="status" aria-live="polite"></div>

  <% if (addonEnabled('handouts')) { %>
  <!-- Handout Reveal Popup -->
  <div class="handout-reveal-overlay" id="handout-reveal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-label="Handout revealed">
    <div class="handout-reveal-backdrop"></div>
    <div class="handout-reveal-content">
      <button type="button" class="handout-reveal-close" id="handout-reveal-close" aria-label="Close">&times;</button>
      <h2 class="handout-reveal-title" id="handout-reveal-title"></h2>
      <div class="handout-reveal-body" id="handout-reveal-body"></div>
      <div class="handout-reveal-footer">
        <button type="button" class="btn btn-primary" id="handout-reveal-dismiss">Dismiss</button>
        <a href="/handouts" class="btn btn-outline" id="handout-reveal-link">View in Handouts</a>
      </div>
    </div>
  </div>
  <% } %>

  <% if (typeof user !== 'undefined' && user && addonEnabled('sound-board')) { %>
  <!-- Sound Panel -->
  <div id="sound-panel" class="sound-panel" data-sound-default="<%= user.sound_default || '' %>" data-csrf="<%= csrfToken %>" style="display:none;">
    <div class="sound-panel-header" id="sound-panel-drag">
      <span>Sound Board</span>
      <button type="button" class="sound-panel-close" id="sound-panel-close">&times;</button>
    </div>
    <div class="sound-panel-body" id="sound-panel-body">
      <!-- Now Playing bar (hidden until a site is opened) -->
      <div class="sound-now-playing" id="sound-now-playing" style="display:none;">
        <span class="sound-now-icon">&#9835;</span>
        <span class="sound-now-name" id="sound-now-name"></span>
        <button type="button" class="btn btn-small btn-outline" id="sound-now-focus">Focus</button>
      </div>
      <!-- Site list -->
      <div class="sound-panel-sites">
        <button type="button" class="btn btn-small sound-site-btn" data-url="https://tabletopy.com" data-name="Tabletopy">
          <span class="sound-site-icon">&#127925;</span>
          <span class="sound-site-label">Tabletopy</span>
          <span class="sound-set-default" title="Set as default">&#9733;</span>
        </button>
        <button type="button" class="btn btn-small sound-site-btn" data-url="https://tabletopaudio.com" data-name="Tabletop Audio">
          <span class="sound-site-icon">&#127926;</span>
          <span class="sound-site-label">Tabletop Audio</span>
          <span class="sound-set-default" title="Set as default">&#9733;</span>
        </button>
        <button type="button" class="btn btn-small sound-site-btn" data-url="https://rpg.ambient-mixer.com" data-name="Ambient Mixer">
          <span class="sound-site-icon">&#127794;</span>
          <span class="sound-site-label">Ambient Mixer</span>
          <span class="sound-set-default" title="Set as default">&#9733;</span>
        </button>
        <button type="button" class="btn btn-small sound-site-btn" data-url="https://mynoise.net" data-name="myNoise">
          <span class="sound-site-icon">&#128266;</span>
          <span class="sound-site-label">myNoise</span>
          <span class="sound-set-default" title="Set as default">&#9733;</span>
        </button>
      </div>
      <div class="sound-panel-divider"></div>
      <div class="sound-panel-custom">
        <label style="font-size:0.75rem;color:var(--text-secondary);display:block;margin-bottom:0.3rem;">Custom URL:</label>
        <div style="display:flex;gap:0.3rem;">
          <input type="url" id="sound-custom-url" placeholder="https://..." style="flex:1;font-size:0.75rem;">
          <button type="button" class="btn btn-small btn-primary" id="sound-custom-open">Open</button>
          <span class="sound-set-default" id="sound-custom-default" title="Set as default">&#9733;</span>
        </div>
      </div>
      <div class="sound-panel-divider"></div>
      <p style="margin:0;font-size:0.65rem;color:var(--text-secondary);text-align:center;">
        Audio plays in a separate window.<br>Default site auto-opens with the panel.
      </p>
    </div>
  </div>
  <% } %>

  <footer class="app-footer">
    <div class="container">
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="footer-players" id="active-players"></div>
      <% } %>
      <div class="footer-about">
        <strong>Quest Planner</strong> v<%= appVersion %> &mdash; Open-source D&D session scheduler
      </div>
      <div class="footer-links">
        <a href="https://github.com/nenadjokic/dndplanning" target="_blank">GitHub</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank">GPL-3.0 License</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://buymeacoffee.com/nenadjokic" target="_blank">Buy Me a Coffee</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://paypal.me/nenadjokicRS" target="_blank">PayPal</a>
      </div>
      <div class="footer-copy">
        Made with &hearts; by Nenad Jokic
      </div>
    </div>
  </footer>

  <% if (typeof showWhatsNew !== 'undefined' && showWhatsNew) { %>
    <div class="welcome-overlay" id="whatsnew-overlay">
      <div class="welcome-modal whatsnew-modal">
        <button class="whatsnew-close-x" id="whatsnew-close-x" title="Close">&times;</button>
        <h2>What's New in v<%= appVersion %></h2>
        <div class="whatsnew-content">
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem;">Candlekeep Mysteries &amp; Pack Fixes <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.8)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>Candlekeep Mysteries</strong> &mdash; First official adventure pack in the Browse Store: 17 adventures (levels 1&ndash;16), 29 maps, 83 NPCs with avatars, 40 loot chests with DC checks, 8 image handouts, 17 quests</li>
            <li><strong>Pack Delete Fix</strong> &mdash; Fixed FK constraint errors when deleting imported adventure packs</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Previous Updates <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.7)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>Adventure Packs</strong> &mdash; Export, import, and share complete adventures as .qpa archives with maps, NPCs, loot, quests, locations, handouts, and story arcs</li>
            <li><strong>Browse Store</strong> &mdash; Discover community adventure packs from the official registry or custom GitHub repositories</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Previous Updates <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.6)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>Restore Preview</strong> &mdash; Before restoring, see a comparison of current vs backup data with color-coded diffs</li>
            <li><strong>Restore Progress Page</strong> &mdash; Real-time step-by-step progress tracking with countdown timer and auto-refresh</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Previous Updates <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.5)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>NPC Manager</strong> &mdash; New standalone page to manage all NPCs &mdash; search, filter by category, bulk select &amp; delete, edit, and delete entire categories with one click</li>
            <li><strong>Map Bulk Delete</strong> &mdash; Select multiple maps and delete them all at once from the maps page</li>
            <li><strong>Safe Addon Uninstall</strong> &mdash; Addon uninstall no longer runs destructive database migrations, preserving all user data</li>
            <li><strong>Restore Fix (Docker)</strong> &mdash; Database restore now works correctly in Docker environments</li>
            <li><strong>Dual Google Drive Backup</strong> &mdash; Scheduled backups now upload both .db (database) and .qpb (full archive) to Google Drive</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Previous Updates <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.4)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>Map Publish System</strong> &mdash; Maps are hidden by default; DMs publish them individually or in bulk to make them visible to players</li>
            <li><strong>View as Player</strong> &mdash; DMs can toggle a navbar switch to preview the app exactly as a player sees it &mdash; fog of war, no DM controls, hidden maps</li>
            <li><strong>Secret Page</strong> &mdash; Players trying to access unpublished maps get a fun Zelda-inspired "It's a Secret to Everybody!" page</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Previous Updates <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.3)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>SSE Connection Fix</strong> &mdash; Consolidated 5 SSE connections into 1, fixing map features in Safari</li>
            <li><strong>Map Hierarchy Editing</strong> &mdash; Parent map dropdown in Edit modal</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Previous Fixes <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.2)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>Dashboard Widget Positioning</strong> &mdash; Top-position widgets (e.g., "Previously On...") now render above session cards</li>
            <li><strong>Title Size Fixes</strong> &mdash; Fixed oversized headings in Previously On banner and Quest Journal summaries</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Browse Store Updates <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.1)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>Addon Updates</strong> &mdash; Browse Store shows "Update Available" badge when newer versions exist, with one-click update button</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Addon System & Browse Store <span style="color:var(--text-secondary);font-size:0.8rem;">(v3.0.0)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>Addon System</strong> &mdash; Modular architecture with 17 preinstalled core addons; enable/disable individual features from Addon Management</li>
            <li><strong>Browse Store</strong> &mdash; Install community addons from the official registry or custom GitHub repositories with one-click install/uninstall</li>
            <li><strong>Addon Developer Kit</strong> &mdash; Documentation, scaffolder, validator, and registry preview tools for building your own addons</li>
            <li><strong>Full Backup (.qpb)</strong> &mdash; Complete backup including database, images, maps, uploads, and thumbnails in one archive</li>
            <li><strong>Custom Repositories</strong> &mdash; Add your own GitHub repos as addon sources in the Browse Store</li>
          </ul>
          <h3 style="color: var(--gold); font-size: 0.95rem; margin-bottom: 0.5rem; margin-top: 1rem;">Previous Highlights <span style="color:var(--text-secondary);font-size:0.8rem;">(v2.x)</span></h3>
          <ul class="whatsnew-list">
            <li><strong>Campaign System</strong> &mdash; Organize sessions, maps, quests, loot, and handouts per campaign with filtering</li>
            <li><strong>Google Drive Backup</strong> &mdash; Auto-backup to Google Drive with OAuth2 authorization</li>
            <li><strong>Quest Board</strong> &mdash; Quests with objectives, rewards, NPC givers, map links, story arcs</li>
            <li><strong>Grid Overlay & Sound Board</strong> &mdash; Square/hex grid on maps; ambient audio launchers</li>
          </ul>
        </div>
        <div class="whatsnew-links">
          <a href="https://github.com/nenadjokic/dndplanning/releases" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-small">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            Full Changelog
          </a>
        </div>
        <p style="margin-top: 1rem; margin-bottom: 0.5rem; color: var(--text-secondary);">Enjoy Quest Planner? Support the project:</p>
        <div class="whatsnew-support">
          <a href="https://buymeacoffee.com/nenadjokic" target="_blank" rel="noopener noreferrer">
            <img src="https://img.shields.io/badge/Buy%20Me%20a%20Coffee-ffdd00?style=for-the-badge&logo=buy-me-a-coffee&logoColor=black" alt="Buy Me a Coffee">
          </a>
          <a href="https://paypal.me/nenadjokicRS" target="_blank" rel="noopener noreferrer">
            <img src="https://img.shields.io/badge/PayPal-00457C?style=for-the-badge&logo=paypal&logoColor=white" alt="PayPal">
          </a>
        </div>
        <button class="btn btn-outline" id="whatsnew-close" style="margin-top: 1rem;">Continue to Quest Planner</button>
      </div>
    </div>
    <script>
      document.getElementById('whatsnew-close').addEventListener('click', function() {
        document.getElementById('whatsnew-overlay').remove();
      });
      document.getElementById('whatsnew-close-x').addEventListener('click', function() {
        document.getElementById('whatsnew-overlay').remove();
      });
      document.getElementById('whatsnew-overlay').addEventListener('click', function(e) {
        if (e.target === this) this.remove();
      });
    </script>
  <% } %>

  <% if (typeof firstLogin !== 'undefined' && firstLogin) { %>
    <div class="welcome-overlay" id="welcome-overlay">
      <div class="welcome-modal">
        <h2>Welcome to Quest Planner!</h2>
        <p>Thank you for using this software! Quest Planner is free and open-source, licensed under the GPL-3.0.</p>
        <p>If you enjoy it and would like to support development, consider buying me a coffee:</p>
        <div class="welcome-links">
          <a href="https://buymeacoffee.com/nenadjokic" target="_blank" class="btn btn-primary btn-small">Buy Me a Coffee</a>
          <a href="https://paypal.me/nenadjokicRS" target="_blank" class="btn btn-outline btn-small">PayPal</a>
        </div>
        <p class="form-hint">You can always find these links in the footer.</p>
        <div style="text-align: center; margin: 1rem 0;">
          <img src="/icons/icon-192.png" alt="Quest Planner" style="width: 80px; height: 80px; border-radius: 12px;">
        </div>
        <button class="btn btn-outline" id="welcome-close">Enter the Tavern</button>
      </div>
    </div>
    <script>
      document.getElementById('welcome-close').addEventListener('click', function() {
        document.getElementById('welcome-overlay').remove();
      });
      document.getElementById('welcome-overlay').addEventListener('click', function(e) {
        if (e.target === this) this.remove();
      });
    </script>
  <% } %>

  <script src="/js/toast.js?v=<%= appVersion %>"></script>
  <script src="/js/datetime-picker.js?v=<%= appVersion %>"></script>
  <script src="/js/menu.js?v=<%= appVersion %>"></script>
  <script src="/js/app.js?v=<%= appVersion %>"></script>
  <script src="/js/dnd-modals.js?v=<%= appVersion %>"></script>
  <% if (typeof user !== 'undefined' && user && addonEnabled('dice-roller')) { %>
    <script>if(!window.THREE){document.write('<script src="https://unpkg.com/three@0.160.0/build/three.min.js"><\/script>')}</script>
    <link rel="stylesheet" href="/css/dice-roller.css?v=<%= appVersion %>">
    <script src="/js/dice-geometry.js?v=<%= appVersion %>"></script>
    <script src="/js/dice-themes.js?v=<%= appVersion %>"></script>
    <script type="module" src="/js/dice-roller.js?v=<%= appVersion %>"></script>
  <% } %>
  <% if (typeof addonJS !== 'undefined' && addonJS.length > 0) { %>
    <% for (const js of addonJS) { %>
    <script src="<%= js %>"></script>
    <% } %>
  <% } %>
</body>
</html>
