<div class="page-header">
  <h2>Campaigns</h2>
  <a href="/campaigns" class="btn btn-secondary">View All</a>
</div>
<% if (typeof campaigns !== 'undefined' && campaigns.length > 0) { %>
<div class="campaign-grid campaign-grid-dashboard">
  <% campaigns.forEach(c => { %>
    <a href="/campaigns/<%= c.id %>" class="campaign-card card" style="border-top: 3px solid <%= c.color || '#d4a843' %>;">
      <% if (c.cover_image) { %>
        <div class="campaign-cover campaign-cover-sm" style="background-image: url('/uploads/campaigns/<%= c.cover_image %>');"></div>
      <% } else { %>
        <div class="campaign-cover campaign-cover-sm campaign-cover-default" style="background-color: <%= c.color || '#d4a843' %>;">
          <span class="campaign-cover-icon">&#9876;</span>
        </div>
      <% } %>
      <div class="campaign-card-body">
        <h2 class="campaign-card-title"><%= c.name %></h2>
        <div class="campaign-card-stats">
          <span><%= c.session_count %> sessions</span>
          <span><%= c.map_count %> maps</span>
          <span><%= c.quest_count %> quests</span>
        </div>
      </div>
    </a>
  <% }); %>
</div>
<% } else { %>
<p style="color: var(--text-secondary); font-size: 0.9rem;">No campaigns yet. <a href="/campaigns">Create your first campaign</a>.</p>
<% } %>
