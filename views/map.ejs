  </div>
  <div class="combat-panel-footer">
    <button type="button" class="btn btn-primary btn-small" id="combat-start-btn" disabled>Start Combat</button>
    <button type="button" class="btn btn-outline btn-small" id="combat-selection-cancel-btn">Cancel</button>
  </div>
</div>
