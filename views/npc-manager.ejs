<%- include('partials/head') %>

<div class="container" style="padding-top:1rem; padding-bottom:2rem;">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem;">
    <h1 style="font-family:var(--font-heading);color:var(--gold);margin:0;font-size:1.5rem;">NPC Manager</h1>
    <div style="display:flex;gap:0.5rem;align-items:center;">
      <button type="button" class="btn btn-primary btn-small" id="create-npc-btn">+ New NPC</button>
      <input type="text" id="npc-search" placeholder="Search NPCs..." style="font-size:0.85rem;padding:0.3rem 0.6rem;min-width:180px;">
      <select id="npc-filter-cat" style="font-size:0.85rem;padding:0.3rem 0.6rem;">
        <option value="">All Categories</option>
        <option value="uncategorized">Uncategorized</option>
        <% for (const cat of categories) { %>
        <option value="<%= cat.id %>"><%= cat.name %> (<%= cat.npc_count %>)</option>
        <% } %>
      </select>
    </div>
  </div>

  <!-- Bulk Actions Bar -->
  <div id="bulk-actions" class="card" style="display:none; margin-bottom:1rem; padding:0.5rem 1rem; border:1px solid var(--gold-dim);">
    <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
      <label style="font-size:0.85rem;display:flex;align-items:center;gap:0.3rem;cursor:pointer;">
        <input type="checkbox" id="select-all-cb"> Select All Visible
      </label>
      <span id="selected-count" style="font-size:0.85rem;color:var(--text-secondary);">0 selected</span>
      <button type="button" class="btn btn-danger btn-small" id="bulk-delete-btn">Delete Selected</button>
      <button type="button" class="btn btn-outline btn-small" id="bulk-deselect-btn">Deselect All</button>
    </div>
  </div>

  <!-- Category Management -->
  <div class="card" style="margin-bottom:1rem;padding:0.75rem 1rem;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
      <h3 style="margin:0;font-size:0.95rem;color:var(--gold);">Categories</h3>
      <div style="display:flex;gap:0.3rem;align-items:center;">
        <input type="text" id="new-cat-name" placeholder="New category..." style="font-size:0.8rem;padding:0.25rem 0.5rem;width:160px;">
        <button type="button" class="btn btn-primary btn-small" id="add-cat-btn">Add</button>
      </div>
    </div>
    <div id="cat-list" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.5rem;">
      <% for (const cat of categories) { %>
      <div class="npc-mgr-cat-tag" data-cat-id="<%= cat.id %>">
        <span class="npc-mgr-cat-name" title="Click to rename" data-cat-id="<%= cat.id %>" style="cursor:pointer;"><%= cat.name %></span>
        <span class="npc-mgr-cat-count">(<%= cat.npc_count %>)</span>
        <button type="button" class="npc-mgr-cat-del-npcs" title="Delete all NPCs in this category" data-cat-id="<%= cat.id %>" data-cat-name="<%= cat.name %>">Delete NPCs</button>
        <button type="button" class="npc-mgr-cat-del" title="Delete category (NPCs keep)" data-cat-id="<%= cat.id %>" data-cat-name="<%= cat.name %>">&times;</button>
      </div>
      <% } %>
      <% if (categories.length === 0) { %>
      <span style="color:var(--text-secondary);font-size:0.85rem;">No categories yet</span>
      <% } %>
    </div>
  </div>

  <!-- NPC Table -->
  <div class="card" style="padding:0;overflow-x:auto;">
    <table class="npc-mgr-table">
      <thead>
        <tr>
          <th style="width:40px;"><input type="checkbox" id="header-select-all"></th>
          <th style="width:50px;">Avatar</th>
          <th>Name</th>
          <th>Category</th>
          <th style="width:80px;">HP</th>
          <th style="width:80px;">On Maps</th>
          <th style="width:80px;">Actions</th>
        </tr>
      </thead>
      <tbody id="npc-tbody">
        <% for (const npc of npcs) { %>
        <tr class="npc-row" data-npc-id="<%= npc.id %>" data-cat-id="<%= npc.category_id || '' %>" data-cat-ids="<%= (npc.category_ids || []).join(',') %>" data-name="<%= npc.name.toLowerCase() %>" style="cursor:pointer;">
          <td onclick="event.stopPropagation()"><input type="checkbox" class="npc-select-cb" value="<%= npc.id %>"></td>
          <td>
            <% if (npc.avatar) { %>
            <img src="<%= npc.avatar %>" alt="" class="npc-mgr-avatar">
            <% } else { %>
            <div class="npc-mgr-avatar npc-mgr-avatar-placeholder"><%= npc.name.charAt(0).toUpperCase() %></div>
            <% } %>
          </td>
          <td class="npc-mgr-name"><%= npc.name %></td>
          <td>
            <% const npcCats = categories.filter(c => (npc.category_ids || []).includes(c.id) || npc.category_id === c.id); %>
            <% if (npcCats.length > 0) { %>
              <% for (const c of npcCats) { %><span class="npc-mgr-cat-badge"><%= c.name %></span> <% } %>
            <% } else { %>
              <span style="color:var(--text-secondary);font-size:0.8rem;">--</span>
            <% } %>
          </td>
          <td><%= npc.max_hp > 0 ? npc.max_hp : '--' %></td>
          <td><%= npc.placement_count %></td>
          <td onclick="event.stopPropagation()">
            <button type="button" class="btn btn-danger btn-small npc-delete-btn" data-npc-id="<%= npc.id %>" data-npc-name="<%= npc.name %>">Del</button>
          </td>
        </tr>
        <% } %>
        <% if (npcs.length === 0) { %>
        <tr><td colspan="7" style="text-align:center;color:var(--text-secondary);padding:2rem;">No NPCs yet. Click "+ New NPC" to create one.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div style="margin-top:0.5rem;color:var(--text-secondary);font-size:0.8rem;">
    <span id="npc-total-count"><%= npcs.length %></span> NPC(s) total
  </div>
</div>

<!-- NPC Edit/Create Modal (matches map NPC form) -->
<div id="npc-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:var(--bg-card);border:1px solid var(--gold-dim);border-radius:12px;padding:1.5rem;max-width:520px;width:90%;max-height:90vh;overflow-y:auto;box-shadow:0 8px 32px rgba(0,0,0,0.5);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
      <h3 id="npc-modal-title" style="font-family:var(--font-heading);color:var(--gold);margin:0;font-size:1.1rem;">Edit NPC</h3>
      <button type="button" id="npc-modal-close" style="background:none;border:none;color:var(--text-secondary);font-size:1.5rem;cursor:pointer;padding:0;line-height:1;">&times;</button>
    </div>
    <div id="npc-modal-body">
      <!-- Source selector -->
      <div id="npc-source-section" style="margin-bottom:0.75rem;">
        <label style="font-size:0.85rem;color:var(--text-secondary);">Source</label>
        <div style="display:flex;gap:0.35rem;margin-top:0.25rem;">
          <button type="button" class="btn btn-small btn-primary npc-source-btn active" data-source="custom">Custom</button>
          <button type="button" class="btn btn-small btn-outline npc-source-btn" data-source="bestiary">Bestiary</button>
        </div>
        <div id="npc-bestiary-search" style="display:none;margin-top:0.5rem;">
          <div style="display:flex;gap:0.35rem;">
            <input type="text" id="npc-bestiary-query" placeholder="Search monsters..." style="flex:1;padding:0.3rem 0.5rem;font-size:0.85rem;">
            <button type="button" class="btn btn-small btn-outline" id="npc-bestiary-search-btn">Search</button>
          </div>
          <div id="npc-bestiary-results" style="max-height:150px;overflow-y:auto;margin-top:0.35rem;"></div>
        </div>
      </div>
      <!-- NPC Form -->
      <form id="npc-form" enctype="multipart/form-data">
        <input type="hidden" id="npc-form-id" value="">
        <input type="hidden" id="npc-form-source-type" value="custom">
        <input type="hidden" id="npc-form-source-key" value="">
        <div class="form-group" style="margin-bottom:0.5rem;">
          <label style="font-size:0.85rem;">Name *</label>
          <input type="text" name="name" id="npc-form-name" required placeholder="NPC name" style="padding:0.35rem 0.5rem;font-size:0.85rem;">
        </div>
        <div style="display:flex;gap:0.5rem;align-items:flex-start;">
          <div class="form-group" style="flex:1;margin-bottom:0.5rem;">
            <label style="font-size:0.85rem;">Categories</label>
            <div id="npc-form-cats" style="display:flex;flex-wrap:wrap;gap:0.35rem;max-height:80px;overflow-y:auto;padding:0.25rem 0;">
              <% for (const cat of categories) { %>
              <label style="display:flex;align-items:center;gap:0.25rem;font-size:0.8rem;cursor:pointer;">
                <input type="checkbox" name="category_ids" value="<%= cat.id %>"> <%= cat.name %>
              </label>
              <% } %>
            </div>
          </div>
          <div class="form-group" style="width:90px;margin-bottom:0.5rem;">
            <label style="font-size:0.85rem;">Max HP</label>
            <input type="number" name="max_hp" id="npc-form-hp" min="0" value="0" style="width:100%;padding:0.35rem 0.4rem;font-size:0.85rem;">
          </div>
        </div>
        <div class="form-group" style="margin-bottom:0.5rem;">
          <label style="font-size:0.85rem;">Avatar</label>
          <div id="npc-avatar-current" style="display:none;margin-bottom:0.35rem;">
            <img id="npc-avatar-current-img" src="" style="max-width:60px;max-height:60px;border-radius:50%;border:2px solid var(--gold);">
          </div>
          <div id="npc-avatar-auto-section" style="display:none;margin-bottom:0.35rem;">
            <button type="button" id="npc-fetch-avatar-btn" class="btn btn-outline btn-small" style="font-size:0.8rem;width:100%;">Fetch avatar from D&amp;D 5e SRD</button>
            <div id="npc-fetch-avatar-status" style="font-size:0.75rem;color:var(--text-secondary);margin-top:0.2rem;"></div>
          </div>
          <input type="file" name="avatar" id="npc-form-avatar" accept="image/*" style="font-size:0.8rem;">
          <div id="npc-form-avatar-preview" style="margin-top:0.25rem;"></div>
        </div>
        <div class="form-group" style="margin-bottom:0.5rem;">
          <label style="font-size:0.85rem;">Notes</label>
          <textarea name="notes" id="npc-form-notes" rows="3" style="padding:0.35rem 0.5rem;font-size:0.85rem;" placeholder="Optional notes"></textarea>
        </div>
        <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
          <button type="button" class="btn btn-outline" id="npc-modal-cancel">Cancel</button>
          <button type="submit" class="btn btn-primary" id="npc-form-submit">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function() {
  var csrfToken = '<%= csrfToken %>';
  var searchInput = document.getElementById('npc-search');
  var filterCat = document.getElementById('npc-filter-cat');
  var bulkBar = document.getElementById('bulk-actions');
  var rows = document.querySelectorAll('.npc-row');

  // --- Filtering ---
  function filterRows() {
    var q = (searchInput.value || '').toLowerCase().trim();
    var cat = filterCat.value;
    rows.forEach(function(row) {
      var name = row.getAttribute('data-name');
      var catId = row.getAttribute('data-cat-id');
      var catIds = (row.getAttribute('data-cat-ids') || '').split(',');
      var matchName = !q || name.indexOf(q) !== -1;
      var matchCat = !cat || (cat === 'uncategorized' ? (!catId && catIds.join('') === '') : (catId === cat || catIds.indexOf(cat) !== -1));
      if (matchName && matchCat) { row.style.display = ''; }
      else { row.style.display = 'none'; row.querySelector('.npc-select-cb').checked = false; }
    });
    updateBulkBar();
  }
  searchInput.addEventListener('input', filterRows);
  filterCat.addEventListener('change', filterRows);

  // --- Selection ---
  function updateBulkBar() {
    var checked = document.querySelectorAll('.npc-select-cb:checked');
    if (checked.length > 0) {
      bulkBar.style.display = 'block';
      document.getElementById('selected-count').textContent = checked.length + ' selected';
    } else {
      bulkBar.style.display = 'none';
    }
  }
  document.querySelectorAll('.npc-select-cb').forEach(function(cb) { cb.addEventListener('change', updateBulkBar); });
  document.getElementById('header-select-all').addEventListener('change', function() {
    var c = this.checked;
    rows.forEach(function(r) { if (r.style.display !== 'none') r.querySelector('.npc-select-cb').checked = c; });
    updateBulkBar();
  });
  document.getElementById('select-all-cb').addEventListener('change', function() {
    var c = this.checked;
    rows.forEach(function(r) { if (r.style.display !== 'none') r.querySelector('.npc-select-cb').checked = c; });
    updateBulkBar();
  });
  document.getElementById('bulk-deselect-btn').addEventListener('click', function() {
    document.querySelectorAll('.npc-select-cb').forEach(function(cb) { cb.checked = false; });
    document.getElementById('header-select-all').checked = false;
    document.getElementById('select-all-cb').checked = false;
    updateBulkBar();
  });

  // --- Bulk Delete ---
  document.getElementById('bulk-delete-btn').addEventListener('click', function() {
    var ids = [];
    document.querySelectorAll('.npc-select-cb:checked').forEach(function(cb) { ids.push(parseInt(cb.value)); });
    if (ids.length === 0) return;
    if (!confirm('Delete ' + ids.length + ' NPC(s)? This will also remove them from all maps. This cannot be undone!')) return;
    fetch('/map/npcs/bulk-delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ npc_ids: ids })
    }).then(function(r) { return r.json(); }).then(function(d) { if (d.success) location.reload(); });
  });

  // --- Single Delete ---
  document.querySelectorAll('.npc-delete-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var npcId = btn.getAttribute('data-npc-id');
      var npcName = btn.getAttribute('data-npc-name');
      if (!confirm('Delete "' + npcName + '"? This will remove it from all maps.')) return;
      fetch('/map/npcs/' + npcId + '/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
      }).then(function(r) { return r.json(); }).then(function(d) { if (d.success) location.reload(); });
    });
  });

  // --- Category: Add ---
  function addCategory() {
    var input = document.getElementById('new-cat-name');
    var name = input.value.trim();
    if (!name) return;
    fetch('/map/npcs/categories', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ name: name })
    }).then(function(r) { return r.json(); }).then(function(d) { if (d.success) location.reload(); });
  }
  document.getElementById('add-cat-btn').addEventListener('click', addCategory);
  document.getElementById('new-cat-name').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); addCategory(); }
  });

  // --- Category: Rename ---
  document.querySelectorAll('.npc-mgr-cat-name[data-cat-id]').forEach(function(span) {
    span.addEventListener('click', function(e) {
      e.stopPropagation();
      if (span.querySelector('input')) return;
      var catId = span.getAttribute('data-cat-id');
      var oldName = span.textContent.trim();
      var input = document.createElement('input');
      input.type = 'text';
      input.value = oldName;
      input.style.cssText = 'font-size:0.8rem;padding:0.1rem 0.3rem;width:' + Math.max(80, oldName.length * 8 + 20) + 'px;background:var(--bg-darker);color:var(--text-primary);border:1px solid var(--gold);border-radius:3px;';
      span.textContent = '';
      span.appendChild(input);
      input.focus();
      input.select();
      function save() {
        var newName = input.value.trim();
        if (!newName || newName === oldName) { span.textContent = oldName; return; }
        fetch('/map/npcs/categories/' + catId + '/rename', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ name: newName })
        }).then(function(r) { return r.json(); }).then(function(d) {
          if (d.success) location.reload(); else span.textContent = oldName;
        }).catch(function() { span.textContent = oldName; });
      }
      input.addEventListener('blur', save);
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
        if (e.key === 'Escape') { span.textContent = oldName; }
      });
    });
  });

  // --- Category: Delete ---
  document.querySelectorAll('.npc-mgr-cat-del').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var catId = btn.getAttribute('data-cat-id');
      var catName = btn.getAttribute('data-cat-name');
      if (!confirm('Delete category "' + catName + '"? NPCs will be uncategorized but NOT deleted.')) return;
      fetch('/map/npcs/categories/' + catId + '/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
      }).then(function(r) { return r.json(); }).then(function(d) { if (d.success) location.reload(); });
    });
  });

  // --- Category: Delete all NPCs in category ---
  document.querySelectorAll('.npc-mgr-cat-del-npcs').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var catId = btn.getAttribute('data-cat-id');
      var catName = btn.getAttribute('data-cat-name');
      var delCat = confirm('Delete ALL NPCs in "' + catName + '" AND the category itself?\n\nClick OK to delete NPCs + category.\nClick Cancel to keep the category (only NPCs deleted).');
      if (!confirm('Are you sure you want to delete ALL NPCs in "' + catName + '"? This removes them from all maps and cannot be undone!')) return;
      fetch('/map/npcs/categories/' + catId + '/delete-npcs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ delete_category: delCat })
      }).then(function(r) { return r.json(); }).then(function(d) { if (d.success) location.reload(); });
    });
  });

  // =============================================
  // NPC Modal (Create / Edit)
  // =============================================
  var modal = document.getElementById('npc-modal');
  var form = document.getElementById('npc-form');
  var npcCurrentSource = 'custom';

  function closeModal() { modal.style.display = 'none'; }
  document.getElementById('npc-modal-close').addEventListener('click', closeModal);
  document.getElementById('npc-modal-cancel').addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

  function resetForm() {
    document.getElementById('npc-form-id').value = '';
    document.getElementById('npc-form-name').value = '';
    document.getElementById('npc-form-hp').value = '0';
    document.getElementById('npc-form-notes').value = '';
    document.getElementById('npc-form-avatar').value = '';
    document.getElementById('npc-form-source-type').value = 'custom';
    document.getElementById('npc-form-source-key').value = '';
    document.getElementById('npc-form-avatar-preview').innerHTML = '';
    document.getElementById('npc-avatar-current').style.display = 'none';
    document.getElementById('npc-avatar-auto-section').style.display = 'none';
    document.getElementById('npc-fetch-avatar-status').textContent = '';
    document.getElementById('npc-bestiary-results').innerHTML = '';
    document.getElementById('npc-bestiary-query').value = '';
    form.querySelectorAll('input[name="category_ids"]').forEach(function(cb) { cb.checked = false; });
    setSource('custom');
  }

  // Source selector
  function setSource(source) {
    npcCurrentSource = source;
    document.getElementById('npc-form-source-type').value = source;
    document.querySelectorAll('.npc-source-btn').forEach(function(b) {
      b.classList.toggle('active', b.getAttribute('data-source') === source);
      b.classList.toggle('btn-primary', b.getAttribute('data-source') === source);
      b.classList.toggle('btn-outline', b.getAttribute('data-source') !== source);
    });
    document.getElementById('npc-bestiary-search').style.display = source === 'bestiary' ? 'block' : 'none';
    document.getElementById('npc-avatar-auto-section').style.display = source === 'bestiary' ? 'block' : 'none';
  }
  document.querySelectorAll('.npc-source-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { setSource(btn.getAttribute('data-source')); });
  });

  // Bestiary search
  document.getElementById('npc-bestiary-search-btn').addEventListener('click', bestiarySearch);
  document.getElementById('npc-bestiary-query').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); bestiarySearch(); }
  });
  function bestiarySearch() {
    var q = document.getElementById('npc-bestiary-query').value.trim();
    if (!q) return;
    var resultsDiv = document.getElementById('npc-bestiary-results');
    resultsDiv.innerHTML = '<div style="font-size:0.8rem;color:var(--text-secondary);padding:0.25rem;">Searching...</div>';
    fetch('https://api.open5e.com/v2/creatures/?name__icontains=' + encodeURIComponent(q) + '&format=json&fields=name,key,hp,document__title')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var items = data.results || [];
        if (items.length === 0) {
          resultsDiv.innerHTML = '<div style="font-size:0.8rem;color:var(--text-secondary);padding:0.25rem;">No results found</div>';
          return;
        }
        resultsDiv.innerHTML = '';
        items.slice(0, 20).forEach(function(item) {
          var div = document.createElement('div');
          div.style.cssText = 'padding:0.3rem 0.4rem;cursor:pointer;font-size:0.8rem;border-bottom:1px solid rgba(255,255,255,0.05);display:flex;justify-content:space-between;align-items:center;';
          div.innerHTML = '<span style="color:var(--text-primary);">' + item.name + '</span><span style="color:var(--text-secondary);font-size:0.75rem;">HP: ' + (item.hp || '?') + '</span>';
          div.addEventListener('mouseenter', function() { div.style.background = 'var(--bg-darker)'; });
          div.addEventListener('mouseleave', function() { div.style.background = ''; });
          div.addEventListener('click', function() {
            document.getElementById('npc-form-name').value = item.name;
            document.getElementById('npc-form-source-key').value = item.key || '';
            if (item.hp) document.getElementById('npc-form-hp').value = item.hp;
            document.getElementById('npc-form-avatar-preview').innerHTML = '';
            resultsDiv.innerHTML = '<div style="font-size:0.8rem;color:var(--gold);padding:0.25rem;">Selected: ' + item.name + '</div>';
            // Auto-fetch details for notes
            if (item.key) {
              fetch('https://api.open5e.com/v2/creatures/' + item.key + '/?format=json')
                .then(function(r) { return r.json(); })
                .then(function(detail) {
                  var notes = [];
                  if (detail.size) notes.push('Size: ' + detail.size.name);
                  if (detail.type) notes.push('Type: ' + detail.type.name);
                  if (detail.alignment) notes.push('Alignment: ' + detail.alignment);
                  if (detail.armor_class) notes.push('AC: ' + detail.armor_class);
                  if (detail.challenge_rating) notes.push('CR: ' + detail.challenge_rating);
                  if (notes.length) document.getElementById('npc-form-notes').value = notes.join(' | ');
                }).catch(function() {});
            }
          });
          resultsDiv.appendChild(div);
        });
      })
      .catch(function() {
        resultsDiv.innerHTML = '<div style="font-size:0.8rem;color:#e74c3c;padding:0.25rem;">Search failed</div>';
      });
  }

  // Fetch avatar from D&D 5e SRD
  document.getElementById('npc-fetch-avatar-btn').addEventListener('click', function() {
    var name = document.getElementById('npc-form-name').value.trim();
    if (!name) { document.getElementById('npc-fetch-avatar-status').textContent = 'Enter a name first'; return; }
    var status = document.getElementById('npc-fetch-avatar-status');
    status.textContent = 'Fetching...';
    fetch('https://api.open5e.com/v2/creatures/?name=' + encodeURIComponent(name) + '&format=json&fields=name,key')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var match = (data.results || []).find(function(m) { return m.name.toLowerCase() === name.toLowerCase(); });
        if (!match) { status.textContent = 'No exact match found'; return; }
        var imageUrl = 'https://api.open5e.com/v2/creatures/' + match.key + '/image/';
        document.getElementById('npc-form-avatar-preview').innerHTML = '<img src="' + imageUrl + '" style="max-width:60px;max-height:60px;border-radius:50%;border:2px solid var(--gold);margin-top:0.25rem;" onerror="this.parentNode.innerHTML=\'No image available\'"><input type="hidden" name="avatar_url" value="' + imageUrl + '">';
        status.textContent = 'Avatar loaded!';
      })
      .catch(function() { status.textContent = 'Fetch failed'; });
  });

  // --- Open modal: CREATE ---
  document.getElementById('create-npc-btn').addEventListener('click', function() {
    resetForm();
    document.getElementById('npc-modal-title').textContent = 'Create NPC';
    document.getElementById('npc-source-section').style.display = 'block';
    modal.style.display = 'flex';
    setTimeout(function() { document.getElementById('npc-form-name').focus(); }, 100);
  });

  // --- Open modal: EDIT (click row or edit btn) ---
  function openEditModal(npcId) {
    resetForm();
    document.getElementById('npc-modal-title').textContent = 'Edit NPC';
    document.getElementById('npc-source-section').style.display = 'none';
    fetch('/map/npcs', { headers: { 'X-CSRF-Token': csrfToken } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var npc = data.npcs.find(function(n) { return n.id == npcId; });
        if (!npc) return;
        document.getElementById('npc-form-id').value = npc.id;
        document.getElementById('npc-form-name').value = npc.name;
        document.getElementById('npc-form-hp').value = npc.max_hp || 0;
        document.getElementById('npc-form-notes').value = npc.notes || '';
        // Show current avatar
        if (npc.avatar) {
          var avatarSrc = npc.avatar.startsWith('/') ? npc.avatar : '/avatars/' + npc.avatar;
          document.getElementById('npc-avatar-current-img').src = avatarSrc;
          document.getElementById('npc-avatar-current').style.display = 'block';
        }
        // Show fetch avatar button for bestiary NPCs
        if (npc.source_type === 'bestiary') {
          document.getElementById('npc-avatar-auto-section').style.display = 'block';
        }
        // Check categories
        var npcCatIds = npc.category_ids || (npc.category_id ? [npc.category_id] : []);
        form.querySelectorAll('input[name="category_ids"]').forEach(function(cb) {
          cb.checked = npcCatIds.indexOf(parseInt(cb.value)) !== -1;
        });
        modal.style.display = 'flex';
      });
  }

  // Click NPC row to edit
  rows.forEach(function(row) {
    row.addEventListener('click', function() {
      openEditModal(row.getAttribute('data-npc-id'));
    });
  });

  // --- Form submit (create or edit) ---
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var npcId = document.getElementById('npc-form-id').value;
    var formData = new FormData(form);
    // Fix category_ids
    formData.delete('category_ids');
    form.querySelectorAll('input[name="category_ids"]:checked').forEach(function(cb) {
      formData.append('category_ids', cb.value);
    });
    formData.append('source_type', document.getElementById('npc-form-source-type').value);
    formData.append('source_key', document.getElementById('npc-form-source-key').value);
    var url = npcId ? '/map/npcs/' + npcId + '/edit' : '/map/npcs';
    fetch(url, {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrfToken },
      body: formData
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success) location.reload();
    });
  });
})();
</script>

