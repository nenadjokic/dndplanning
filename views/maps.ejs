<%- include('partials/head', { pageTitle: 'Maps' }) %>

<div class="page-header">
  <h1>Maps</h1>
  <div>
    <% if (isDM) { %>
      <button type="button" class="btn btn-outline btn-small" onclick="document.getElementById('create-map-form').style.display = document.getElementById('create-map-form').style.display === 'none' ? 'block' : 'none'">+ New Map</button>
    <% } %>
    <a href="/" class="btn btn-outline btn-small">Back to Chamber</a>
  </div>
</div>

<%- include('partials/campaign-filter', { campaigns: campaigns, activeCampaignId: activeCampaignId, filterBasePath: '/map' }) %>

<% if (isDM) { %>
  <div id="create-map-form" style="display:none; margin-bottom: 1rem;">
    <div class="card" style="border: 1px solid var(--gold-dim);">
      <h3>Create Map</h3>
      <form action="/map" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="map_name">Map Name</label>
          <input type="text" name="name" id="map_name" required placeholder="e.g. World Map, Dungeon Level 1, Town of Phandalin">
        </div>
        <div class="form-group">
          <label for="map_type">Map Type</label>
          <select name="map_type" id="map_type">
            <% for (const [key, val] of Object.entries(MARKER_TYPES)) { %>
              <option value="<%= key %>"><%= val.icon %> <%= val.label %></option>
            <% } %>
          </select>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button type="submit" class="btn btn-primary btn-small">Create</button>
          <button type="button" class="btn btn-outline btn-small" onclick="document.getElementById('create-map-form').style.display='none'">Cancel</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<% if (tree.length === 0) { %>
  <div class="card">
    <%- include('partials/empty-state', {
      icon: '\uD83D\uDDFA\uFE0F',
      title: 'No Maps Yet',
      description: isDM ? 'Create one above to get started.' : 'The DM has not created any maps yet.',
      cta: ''
    }) %>
  </div>
<% } else { %>
  <%
    function renderMapCard(node, level) {
      var hasChildren = node.children && node.children.length > 0;
      var isUnpublished = !node.published;
      var isStandalone = !node.parent_id && !hasChildren;
      var isChild = level > 0;
  %>
      <div class="map-index-card<%= isChild ? ' map-index-card-sub' : '' %><%= isUnpublished ? ' map-unpublished' : '' %>"
           data-map-id="<%= node.id %>"
           data-depth="<%= level %>"
           data-has-children="<%= hasChildren ? '1' : '0' %>"
           <% if (isDM && isStandalone) { %>draggable="true"<% } %>>
        <% if (isDM) { %><input type="checkbox" class="map-select-checkbox" value="<%= node.id %>" data-map-published="<%= node.published ? '1' : '0' %>"><% } %>
        <a href="/map/<%= node.id %>" style="text-decoration:none;color:inherit;">
          <div class="map-index-card-thumb">
            <% if (node.image_path) { %>
              <img src="/maps/<%= node.image_path %>" alt="<%= node.name %>">
            <% } else { %>
              <div class="maps-tree-placeholder">
                <span><%= MARKER_TYPES[node.map_type] ? MARKER_TYPES[node.map_type].icon : '&#127757;' %></span>
              </div>
            <% } %>
          </div>
        </a>
        <div class="map-index-card-body">
          <h3><a href="/map/<%= node.id %>"><%= node.name %></a></h3>
          <div class="maps-tree-meta">
            <span class="map-type-badge map-type-<%= node.map_type %>"><%= MARKER_TYPES[node.map_type] ? MARKER_TYPES[node.map_type].icon : '&#127757;' %> <%= MARKER_TYPES[node.map_type] ? MARKER_TYPES[node.map_type].label : node.map_type %></span>
            <% if (hasChildren) { %>
              <span class="text-muted" style="font-size: 0.8rem;"><%= node.children.length %> sub-map<%= node.children.length !== 1 ? 's' : '' %></span>
            <% } %>
            <% if (isUnpublished && isDM) { %>
              <span class="map-hidden-badge">🔒 Hidden</span>
            <% } %>
          </div>
          <% if (isDM) { %>
            <div class="map-index-card-actions">
              <% if (node.published) { %>
                <button type="button" class="btn btn-small btn-outline" data-toggle-publish="<%= node.id %>" data-published="1" title="Unpublish">🔒 Hide</button>
              <% } else { %>
                <button type="button" class="btn btn-small btn-primary" data-toggle-publish="<%= node.id %>" data-published="0" title="Publish">📢 Publish</button>
              <% } %>
              <button type="button" class="btn btn-small btn-outline" data-edit-map="<%= node.id %>" data-map-name="<%= node.name %>" data-map-type="<%= node.map_type %>" data-map-desc="<%= (node.description || '').replace(/"/g, '&quot;') %>" data-map-campaign="<%= node.campaign_id || '' %>" title="Edit map">Edit</button>
              <% if (node.parent_id) { %>
                <button type="button" class="btn btn-small btn-outline" data-unparent="<%= node.id %>" title="Detach from parent">Detach</button>
              <% } %>
              <form action="/map/<%= node.id %>/delete" method="POST" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Delete this map<%= hasChildren ? ' and all sub-maps' : '' %>?')">&times;</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    <% if (hasChildren) { %>
      <div class="map-index-submaps" style="margin-left: <%= (level + 1) * 1.5 %>rem;">
        <% for (const child of node.children) { %>
          <% renderMapCard(child, level + 1); %>
        <% } %>
      </div>
    <% } %>
  <% } %>

  <% if (isDM) { %>
  <div id="bulk-actions" class="card" style="display:none; margin-bottom:1rem; padding:0.5rem 1rem; border:1px solid var(--gold-dim);">
    <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
      <span id="selected-count" style="font-size:0.85rem;">0 selected</span>
      <button type="button" class="btn btn-primary btn-small" id="bulk-publish-btn">📢 Publish Selected</button>
      <button type="button" class="btn btn-outline btn-small" id="bulk-unpublish-btn">🔒 Unpublish Selected</button>
      <button type="button" class="btn btn-danger btn-small" id="bulk-delete-btn">🗑 Delete Selected</button>
      <button type="button" class="btn btn-outline btn-small" id="bulk-deselect-btn">Deselect All</button>
    </div>
  </div>
  <% } %>

  <div class="map-card-list">
    <% for (const root of tree) { %>
      <div class="map-card-group">
        <% renderMapCard(root, 0); %>
      </div>
    <% } %>
  </div>
<% } %>

<% if (isDM && tree.length > 0) { %>
<script>
(function() {
  var csrfToken = '<%= csrfToken %>';

  // Publish/Unpublish toggle per map
  document.querySelectorAll('[data-toggle-publish]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var mapId = btn.getAttribute('data-toggle-publish');
      fetch('/map/' + mapId + '/toggle-publish', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success) location.reload();
      });
    });
  });

  // Bulk selection
  var bulkBar = document.getElementById('bulk-actions');
  var checkboxes = document.querySelectorAll('.map-select-checkbox');
  function updateBulkBar() {
    var checked = document.querySelectorAll('.map-select-checkbox:checked');
    if (checked.length > 0) {
      bulkBar.style.display = 'block';
      document.getElementById('selected-count').textContent = checked.length + ' selected';
    } else {
      bulkBar.style.display = 'none';
    }
  }
  checkboxes.forEach(function(cb) {
    cb.addEventListener('change', updateBulkBar);
    cb.addEventListener('click', function(e) { e.stopPropagation(); });
  });

  function bulkAction(action) {
    var ids = [];
    document.querySelectorAll('.map-select-checkbox:checked').forEach(function(cb) { ids.push(parseInt(cb.value)); });
    if (ids.length === 0) return;
    fetch('/map/bulk-publish', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ map_ids: ids, action: action })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success) location.reload();
    });
  }
  var pubBtn = document.getElementById('bulk-publish-btn');
  var unpubBtn = document.getElementById('bulk-unpublish-btn');
  var deselBtn = document.getElementById('bulk-deselect-btn');
  var delBtn = document.getElementById('bulk-delete-btn');
  if (pubBtn) pubBtn.addEventListener('click', function() { bulkAction('publish'); });
  if (unpubBtn) unpubBtn.addEventListener('click', function() { bulkAction('unpublish'); });
  if (delBtn) delBtn.addEventListener('click', function() {
    var ids = [];
    document.querySelectorAll('.map-select-checkbox:checked').forEach(function(cb) { ids.push(parseInt(cb.value)); });
    if (ids.length === 0) return;
    if (!confirm('Delete ' + ids.length + ' map(s) and all their children? This cannot be undone!')) return;
    fetch('/map/bulk-delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ map_ids: ids })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success) location.reload();
    });
  });
  if (deselBtn) deselBtn.addEventListener('click', function() {
    checkboxes.forEach(function(cb) { cb.checked = false; });
    updateBulkBar();
  });

  var draggedId = null;

  document.querySelectorAll('.map-index-card[draggable="true"]').forEach(function(el) {
    el.addEventListener('dragstart', function(e) {
      draggedId = el.getAttribute('data-map-id');
      e.dataTransfer.effectAllowed = 'move';
      el.classList.add('dragging');
    });
    el.addEventListener('dragend', function() {
      draggedId = null;
      el.classList.remove('dragging');
      document.querySelectorAll('.map-index-card.drag-over').forEach(function(t) { t.classList.remove('drag-over'); });
    });
  });

  document.querySelectorAll('.map-index-card[data-map-id]').forEach(function(el) {
    el.addEventListener('dragover', function(e) {
      if (!draggedId) return;
      var targetId = el.getAttribute('data-map-id');
      if (targetId === draggedId) return;
      var depth = parseInt(el.getAttribute('data-depth') || '0');
      if (depth >= 2) return; // max 3 levels
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      el.classList.add('drag-over');
    });
    el.addEventListener('dragleave', function() {
      el.classList.remove('drag-over');
    });
    el.addEventListener('drop', function(e) {
      e.preventDefault();
      el.classList.remove('drag-over');
      if (!draggedId) return;
      var targetId = el.getAttribute('data-map-id');
      if (targetId === draggedId) return;
      fetch('/map/' + draggedId + '/reparent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ parent_id: parseInt(targetId) })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success) location.reload();
        else alert(d.error || 'Failed to reparent map');
      });
    });
  });

  // Unparent (detach) buttons
  document.querySelectorAll('[data-unparent]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var mapId = btn.getAttribute('data-unparent');
      if (!confirm('Detach this map from its parent?')) return;
      fetch('/map/' + mapId + '/unparent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success) location.reload();
        else alert(d.error || 'Failed to detach map');
      });
    });
  });
})();
</script>
<% } %>

<% if (isDM) { %>
<!-- Edit Map Modal -->
<div id="edit-map-modal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.6); display:none; align-items:center; justify-content:center;">
  <div class="card" style="max-width:420px; width:90%; margin:auto; position:relative;">
    <button type="button" onclick="document.getElementById('edit-map-modal').style.display='none'" style="position:absolute;top:0.5rem;right:0.75rem;background:none;border:none;color:var(--text-secondary);font-size:1.2rem;cursor:pointer;">&times;</button>
    <h3>Edit Map</h3>
    <form id="edit-map-form">
      <input type="hidden" id="edit-map-id">
      <div class="form-group">
        <label for="edit-map-name">Name</label>
        <input type="text" id="edit-map-name" required>
      </div>
      <div class="form-group">
        <label for="edit-map-type">Type</label>
        <select id="edit-map-type">
          <% for (const [key, val] of Object.entries(MARKER_TYPES)) { %>
            <option value="<%= key %>"><%= val.icon %> <%= val.label %></option>
          <% } %>
        </select>
      </div>
      <div class="form-group">
        <label for="edit-map-desc">Description</label>
        <textarea id="edit-map-desc" rows="2"></textarea>
      </div>
      <% if (typeof campaigns !== 'undefined' && campaigns.length > 0) { %>
      <div class="form-group">
        <label for="edit-map-campaign">Campaign</label>
        <select id="edit-map-campaign">
          <option value="">-- No campaign --</option>
          <% for (const c of campaigns) { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% } %>
        </select>
      </div>
      <% } %>
      <div class="form-group">
        <label for="edit-map-parent">Parent Map</label>
        <select id="edit-map-parent">
          <option value="">-- None (top level) --</option>
        </select>
        <p class="form-hint" style="margin-top:0.25rem;font-size:0.75rem;">Setting a parent makes this map appear as a pin on the parent map.</p>
      </div>
      <hr style="border-color:var(--border);margin:0.75rem 0;">
      <div class="form-group">
        <label>Add Existing Child Map</label>
        <div style="display:flex;gap:0.5rem;">
          <select id="edit-map-add-child" style="flex:1;">
            <option value="">-- Select map --</option>
          </select>
          <button type="button" class="btn btn-outline btn-small" id="edit-map-add-child-btn">Attach</button>
        </div>
        <p class="form-hint" style="margin-top:0.25rem;font-size:0.75rem;">Attaches an existing map as a sub-map (pin will appear at center).</p>
      </div>
      <button type="submit" class="btn btn-primary btn-small">Save</button>
    </form>
  </div>
</div>
<script>
(function() {
  var csrfToken = '<%= csrfToken %>';

  function loadMapDropdowns(mapId) {
    var parentSel = document.getElementById('edit-map-parent');
    var childSel = document.getElementById('edit-map-add-child');
    parentSel.innerHTML = '<option value="">-- None (top level) --</option>';
    childSel.innerHTML = '<option value="">Loading...</option>';

    fetch('/map/' + mapId + '/standalone-maps')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.maps) return;
        data.maps.forEach(function(m) {
          var opt1 = document.createElement('option');
          opt1.value = m.id;
          opt1.textContent = m.name;
          parentSel.appendChild(opt1);

          var opt2 = document.createElement('option');
          opt2.value = m.id;
          opt2.textContent = m.name;
          childSel.appendChild(opt2);
        });
        childSel.querySelector('option').textContent = '-- Select map --';

        // Set current parent
        fetch('/map/' + mapId + '/info')
          .then(function(r) { return r.json(); })
          .then(function(info) {
            if (info.parent_id) parentSel.value = info.parent_id;
          })
          .catch(function() {});
      });
  }

  document.querySelectorAll('[data-edit-map]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var id = btn.getAttribute('data-edit-map');
      document.getElementById('edit-map-id').value = id;
      document.getElementById('edit-map-name').value = btn.getAttribute('data-map-name');
      document.getElementById('edit-map-type').value = btn.getAttribute('data-map-type');
      document.getElementById('edit-map-desc').value = btn.getAttribute('data-map-desc') || '';
      var campSel = document.getElementById('edit-map-campaign');
      if (campSel) campSel.value = btn.getAttribute('data-map-campaign') || '';
      document.getElementById('edit-map-modal').style.display = 'flex';
      loadMapDropdowns(id);
    });
  });

  document.getElementById('edit-map-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var id = document.getElementById('edit-map-id').value;
    var body = {
      name: document.getElementById('edit-map-name').value,
      map_type: document.getElementById('edit-map-type').value,
      description: document.getElementById('edit-map-desc').value,
      parent_id: document.getElementById('edit-map-parent').value || null
    };
    var campSel = document.getElementById('edit-map-campaign');
    if (campSel) body.campaign_id = campSel.value;

    fetch('/map/' + id + '/edit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
      body: JSON.stringify(body)
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.success) location.reload();
      else alert(d.error || 'Failed to update map');
    });
  });

  // Attach existing child map
  var addChildBtn = document.getElementById('edit-map-add-child-btn');
  if (addChildBtn) {
    addChildBtn.addEventListener('click', function() {
      var sel = document.getElementById('edit-map-add-child');
      var childId = parseInt(sel.value);
      if (!childId) { alert('Please select a map'); return; }
      var parentId = document.getElementById('edit-map-id').value;

      fetch('/map/' + parentId + '/link-existing', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ map_id: childId, pin_x: 50, pin_y: 50 })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success) location.reload();
        else alert(d.error || 'Failed to attach child map');
      });
    });
  }

  document.getElementById('edit-map-modal').addEventListener('click', function(e) {
    if (e.target === this) this.style.display = 'none';
  });
})();
</script>
<% } %>

<%- include('partials/foot') %>
