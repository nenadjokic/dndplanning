<%- include('partials/head', { pageTitle: 'Not Found' }) %>

<div style="text-align: center; padding: 3rem 1rem;">
  <h1 style="font-size: 3rem; color: var(--gold); margin-bottom: 0.5rem;">404</h1>
  <h2>Page Not Found</h2>
  <p style="color: var(--text-secondary); margin: 1rem 0;">
    <%= typeof message !== 'undefined' && message ? message : 'The page you are looking for does not exist.' %>
  </p>
  <a href="/" class="btn btn-primary">Return to Dashboard</a>
</div>

<%- include('partials/foot') %>
