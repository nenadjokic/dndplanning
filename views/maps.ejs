<%- include('partials/head', { pageTitle: 'Maps' }) %>

<div class="page-header">
  <h1>Maps</h1>
  <div>
    <% if (isDM) { %>
      <button type="button" class="btn btn-outline btn-small" onclick="document.getElementById('create-map-form').style.display = document.getElementById('create-map-form').style.display === 'none' ? 'block' : 'none'">+ New Map</button>
    <% } %>
    <a href="/" class="btn btn-outline btn-small">Back to Chamber</a>
  </div>
</div>

<% if (isDM) { %>
  <div id="create-map-form" style="display:none; margin-bottom: 1rem;">
    <div class="card" style="border: 1px solid var(--gold-dim);">
      <h3>Create Map</h3>
      <form action="/map" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="map_name">Map Name</label>
          <input type="text" name="name" id="map_name" required placeholder="e.g. World Map, Dungeon Level 1, Town of Phandalin">
        </div>
        <div class="form-group">
          <label for="map_type">Map Type</label>
          <select name="map_type" id="map_type">
            <% for (const [key, val] of Object.entries(MARKER_TYPES)) { %>
              <option value="<%= key %>"><%= val.icon %> <%= val.label %></option>
            <% } %>
          </select>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button type="submit" class="btn btn-primary btn-small">Create</button>
          <button type="button" class="btn btn-outline btn-small" onclick="document.getElementById('create-map-form').style.display='none'">Cancel</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<% if (tree.length === 0) { %>
  <div class="card">
    <%- include('partials/empty-state', {
      icon: '\uD83D\uDDFA\uFE0F',
      title: 'No Maps Yet',
      description: isDM ? 'Create one above to get started.' : 'The DM has not created any maps yet.',
      cta: ''
    }) %>
  </div>
<% } else { %>
  <div class="map-card-grid">
    <% for (const root of tree) { %>
      <%
        var hasChildren = root.children && root.children.length > 0;
        var isHidden = !!root.hidden_by;
        var isCreator = root.created_by === (typeof currentUserId !== 'undefined' ? currentUserId : -1);
        var showAsPlaceholder = isHidden && !isCreator && (typeof isAdmin !== 'undefined' && isAdmin);
        var isStandalone = !root.parent_id && !hasChildren;
      %>
      <% if (showAsPlaceholder) { %>
        <div class="map-index-card" style="opacity: 0.4;">
          <div class="map-index-card-thumb"><div class="maps-tree-placeholder"><span>&#128274;</span></div></div>
          <div class="map-index-card-body">
            <h3 style="color: var(--text-secondary);">Hidden Map</h3>
            <span class="map-type-badge" style="background:rgba(255,255,255,0.1);color:var(--text-secondary);">&#128274; Hidden</span>
            <% if (isDM) { %>
              <div class="map-index-card-actions">
                <form action="/map/<%= root.id %>/delete" method="POST" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Delete this hidden map?')">&times;</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <div class="map-index-card" data-map-id="<%= root.id %>" <% if (isDM && isStandalone) { %>draggable="true"<% } %>>
          <a href="/map/<%= root.id %>" style="text-decoration:none;color:inherit;">
            <div class="map-index-card-thumb">
              <% if (root.image_path) { %>
                <img src="/maps/<%= root.image_path %>" alt="<%= root.name %>">
              <% } else { %>
                <div class="maps-tree-placeholder">
                  <span><%= MARKER_TYPES[root.map_type] ? MARKER_TYPES[root.map_type].icon : '&#127757;' %></span>
                </div>
              <% } %>
            </div>
          </a>
          <div class="map-index-card-body">
            <h3><a href="/map/<%= root.id %>"><%= root.name %></a></h3>
            <div class="maps-tree-meta">
              <span class="map-type-badge map-type-<%= root.map_type %>"><%= MARKER_TYPES[root.map_type] ? MARKER_TYPES[root.map_type].icon : '&#127757;' %> <%= MARKER_TYPES[root.map_type] ? MARKER_TYPES[root.map_type].label : root.map_type %></span>
              <% if (isHidden && isCreator) { %>
                <span class="map-hidden-badge" style="font-size:0.7rem;color:var(--text-secondary);background:rgba(255,255,255,0.08);padding:0.1rem 0.4rem;border-radius:999px;">&#128274; Hidden</span>
              <% } %>
            </div>
            <% if (hasChildren) { %>
              <div class="map-index-card-children">
                <% for (const child of root.children) { %>
                  <a href="/map/<%= child.id %>"><%= child.name %></a>
                <% } %>
              </div>
            <% } %>
            <% if (isDM) { %>
              <div class="map-index-card-actions">
                <form action="/map/<%= root.id %>/delete" method="POST" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Delete this map<%= hasChildren ? ' and all sub-maps' : '' %>?')">&times;</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
    <% } %>
  </div>
<% } %>

<% if (isDM && tree.length > 0) { %>
<script>
(function() {
  var csrfToken = '<%= csrfToken %>';
  var draggedId = null;

  document.querySelectorAll('.map-index-card[draggable="true"]').forEach(function(el) {
    el.addEventListener('dragstart', function(e) {
      draggedId = el.getAttribute('data-map-id');
      e.dataTransfer.effectAllowed = 'move';
      el.classList.add('dragging');
    });
    el.addEventListener('dragend', function() {
      draggedId = null;
      el.classList.remove('dragging');
      document.querySelectorAll('.map-index-card.drag-over').forEach(function(t) { t.classList.remove('drag-over'); });
    });
  });

  document.querySelectorAll('.map-index-card[data-map-id]').forEach(function(el) {
    el.addEventListener('dragover', function(e) {
      if (!draggedId) return;
      var targetId = el.getAttribute('data-map-id');
      if (targetId === draggedId) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      el.classList.add('drag-over');
    });
    el.addEventListener('dragleave', function() {
      el.classList.remove('drag-over');
    });
    el.addEventListener('drop', function(e) {
      e.preventDefault();
      el.classList.remove('drag-over');
      if (!draggedId) return;
      var targetId = el.getAttribute('data-map-id');
      if (targetId === draggedId) return;
      fetch('/map/' + draggedId + '/reparent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ parent_id: parseInt(targetId) })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success) location.reload();
        else alert(d.error || 'Failed to reparent map');
      });
    });
  });
})();
</script>
<% } %>

<%- include('partials/foot') %>
