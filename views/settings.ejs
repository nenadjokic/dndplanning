<%- include('partials/head', { pageTitle: 'Settings' }) %>

<div class="page-header">
  <h1>Settings</h1>
  <a href="/" class="btn btn-outline">Back to Dashboard</a>
</div>

<div class="settings-section card">
  <h2>Tavern Preferences</h2>
  <p class="form-hint">Changes save automatically</p>
  <form id="settings-form" action="/settings" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label>Theme</label>
      <div class="radio-group">
        <label><input type="radio" name="theme" value="dark" data-autosave <%= (settingsUser.theme || 'dark') === 'dark' ? 'checked' : '' %>> Dark (Dungeon)</label>
        <label><input type="radio" name="theme" value="light" data-autosave <%= settingsUser.theme === 'light' ? 'checked' : '' %>> Light (Parchment)</label>
        <label><input type="radio" name="theme" value="auto" data-autosave <%= settingsUser.theme === 'auto' ? 'checked' : '' %>> Auto (Light 6AM&ndash;7PM)</label>
      </div>
    </div>

    <div class="form-group">
      <label>Time Format</label>
      <div class="radio-group">
        <label><input type="radio" name="time_format" value="24h" data-autosave <%= (user.time_format || '24h') === '24h' ? 'checked' : '' %>> 24-hour (14:30)</label>
        <label><input type="radio" name="time_format" value="12h" data-autosave <%= user.time_format === '12h' ? 'checked' : '' %>> 12-hour (2:30 PM)</label>
      </div>
    </div>

    <div class="form-group">
      <label>Week Starts On</label>
      <div class="radio-group">
        <label><input type="radio" name="week_start" value="monday" data-autosave <%= (user.week_start || 'monday') === 'monday' ? 'checked' : '' %>> Monday</label>
        <label><input type="radio" name="week_start" value="sunday" data-autosave <%= user.week_start === 'sunday' ? 'checked' : '' %>> Sunday</label>
      </div>
    </div>
  </form>
</div>

<div class="settings-section card">
  <h2>Guard Phrase</h2>
  <form action="/settings/password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label for="current_password">Current Password</label>
      <div class="password-toggle-wrap">
        <input type="password" id="current_password" name="current_password" required>
        <button type="button" class="password-toggle-btn" onclick="togglePassword('current_password', this)" aria-label="Show password">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </button>
      </div>
    </div>
    <div class="form-group">
      <label for="new_password">New Password</label>
      <div class="password-toggle-wrap">
        <input type="password" id="new_password" name="new_password" required minlength="4">
        <button type="button" class="password-toggle-btn" onclick="togglePassword('new_password', this)" aria-label="Show password">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </button>
      </div>
    </div>
    <div class="form-group">
      <label for="confirm_password">Confirm New Password</label>
      <div class="password-toggle-wrap">
        <input type="password" id="confirm_password" name="confirm_password" required minlength="4">
        <button type="button" class="password-toggle-btn" onclick="togglePassword('confirm_password', this)" aria-label="Show password">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </button>
      </div>
    </div>
    <button type="submit" class="btn btn-primary btn-small">Change Password</button>
  </form>
</div>

<div class="settings-section card">
  <h2>Days Away from the Realm</h2>
  <p class="form-hint">Mark dates when you cannot play. The DM will see these when creating sessions.</p>
  <form action="/settings/unavailability" method="POST" class="unavail-form" id="unavail-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label for="unavail_date">Date</label>
      <input type="text" class="date-only" id="unavail_date_display" placeholder="Select date..." readonly required>
      <input type="hidden" id="unavail_date" name="date">
    </div>
    <div class="form-group">
      <label for="unavail_reason">Reason (optional)</label>
      <input type="text" id="unavail_reason" name="reason" placeholder="e.g. Vacation, Work trip">
    </div>
    <button type="submit" class="btn btn-primary btn-small">Add Unavailability</button>
  </form>

  <% if (unavailabilities.length > 0) { %>
    <div class="unavail-list">
      <% for (const u of unavailabilities) { %>
        <div class="unavail-item">
          <span class="unavail-date"><%= formatDate(u.date + 'T00:00:00', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', showTime: false }) %></span>
          <% if (u.reason) { %>
            <span class="unavail-reason">&mdash; <%= u.reason %></span>
          <% } %>
          <form action="/settings/unavailability/<%= u.id %>/delete" method="POST" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-small btn-danger">&times;</button>
          </form>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<div class="settings-section card">
  <h2>Chronicle Scroll</h2>
  <p class="form-hint">Subscribe to your D&D sessions in your favorite calendar app. The feed includes confirmed sessions and your unavailability days.</p>
  <% if (calendarUrl) { %>
    <div class="form-group">
      <label>Your Personal Calendar Feed URL</label>
      <input type="text" value="<%= calendarUrl %>" readonly onclick="this.select()" class="calendar-url-input">
    </div>
  <% } %>
  <form action="/settings/generate-calendar-token" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-outline btn-small"><%= calendarUrl ? 'Regenerate Token' : 'Generate Calendar URL' %></button>
  </form>

  <div class="form-group" style="margin-top: 1rem;">
    <label>Sessions-Only Feed (Public)</label>
    <input type="text" value="<%= publicCalendarUrl %>" readonly onclick="this.select()" class="calendar-url-input">
  </div>
  <p class="form-hint">This public feed includes only confirmed sessions (no personal unavailability). Share with anyone.</p>
</div>

<div class="settings-section card">
  <h2>Herald's Whispers</h2>
  <p class="form-hint">Choose which notifications you receive.</p>
  <form action="/settings/notifications" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label><input type="checkbox" name="notif_session_confirmed" value="1" <%= notifPrefs.session_confirmed ? 'checked' : '' %>> Session Confirmed</label>
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="notif_session_cancelled" value="1" <%= notifPrefs.session_cancelled ? 'checked' : '' %>> Session Cancelled</label>
    </div>
    <div class="form-group">
      <label><input type="checkbox" name="notif_mention" value="1" <%= notifPrefs.mention ? 'checked' : '' %>> @Mentions</label>
    </div>
    <button type="submit" class="btn btn-primary btn-small">Save Preferences</button>
  </form>
</div>

<div class="settings-section card">
  <h2>Bard's Instrument</h2>
  <p class="form-hint">Your default Sound Board site loads automatically when you open the panel.</p>
  <% if (settingsUser.sound_default) { %>
    <div class="form-group">
      <label>Current Default</label>
      <p style="margin:0.25rem 0;color:var(--gold);font-family:var(--font-heading);">
        <%
          var sdNames = {
            'https://tabletopy.com': 'Tabletopy',
            'https://tabletopaudio.com': 'Tabletop Audio',
            'https://rpg.ambient-mixer.com': 'Ambient Mixer',
            'https://mynoise.net': 'myNoise'
          };
          var sdName = sdNames[settingsUser.sound_default] || settingsUser.sound_default;
        %>
        <%= sdName %>
      </p>
    </div>
    <button type="button" class="btn btn-outline btn-small btn-danger" id="clear-sound-default">Clear Default</button>
    <script>
      document.getElementById('clear-sound-default').addEventListener('click', function() {
        fetch('/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sound_default: '', _csrf: '<%= csrfToken %>' })
        }).then(function(r) { return r.json(); }).then(function(data) {
          if (data.success) {
            if (window.Toast) window.Toast.info('Sound default cleared', 3000);
            setTimeout(function() { location.reload(); }, 500);
          }
        });
      });
    </script>
  <% } else { %>
    <p style="color:var(--text-secondary);font-size:0.85rem;">None &mdash; set a default from the Sound Board panel.</p>
  <% } %>
</div>

<% if (googleEnabled) { %>
<div class="settings-section card">
  <h2>Google Account</h2>
  <% if (settingsUser.google_id) { %>
    <p>Linked to: <strong><%= settingsUser.google_email %></strong></p>
    <form action="/settings/google/unlink" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-outline btn-small btn-danger">Unlink Google Account</button>
    </form>
  <% } else { %>
    <p class="form-hint">Link your Google account for one-click sign-in.</p>
    <a href="/settings/google/link" class="btn btn-outline btn-small">Link Google Account</a>
  <% } %>
</div>
<% } %>

<script>
  window.__timeFormat = '<%= (typeof user !== 'undefined' && user && user.time_format) ? user.time_format : '24h' %>';
  window.__weekStart = '<%= (typeof user !== 'undefined' && user && user.week_start) ? user.week_start : 'monday' %>';
</script>
<script src="/js/datetime-picker.js?v=<%= appVersion %>"></script>
<script>
// Handle unavailability date picker
document.addEventListener('DOMContentLoaded', function() {
  const unavailDisplay = document.getElementById('unavail_date_display');
  const unavailHidden = document.getElementById('unavail_date');
  const unavailForm = document.getElementById('unavail-form');

  // Update hidden field when date is selected
  if (unavailDisplay) {
    unavailDisplay.addEventListener('change', function() {
      unavailHidden.value = this.dataset.date || '';
    });
  }

  // Validate on submit
  if (unavailForm) {
    unavailForm.addEventListener('submit', function(e) {
      if (!unavailHidden.value) {
        e.preventDefault();
        if (window.Toast) {
          window.Toast.info('Please select a date');
        } else {
          alert('Please select a date');
        }
      }
    });
  }
});
</script>
<script src="/js/auto-save.js?v=<%= appVersion %>"></script>

<%- include('partials/foot') %>
