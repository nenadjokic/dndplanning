<%
  // Only show announcement if addon is enabled and announcement exists
  const showAnnouncement = typeof announcement !== 'undefined' && announcement &&
    (!isProduction || (!announcement.content.includes('UAT') && !announcement.content.includes('TEST')));

  // Build nav structure from addon nav items + core items
  const navItems = (typeof addonNavItems !== 'undefined' ? addonNavItems : []);

  // Separate addon nav items by group
  const addonMain = navItems.filter(i => i.group === 'main');
  const addonTools = navItems.filter(i => i.group === 'tools' && i.addonType !== 'community');
  const addonDMZone = navItems.filter(i => i.group === 'dmzone' && i.addonType !== 'community');
  const addonAdmin = navItems.filter(i => i.group === 'admin');

  // Community addon items get their own "Addons" section
  const addonCommunity = navItems.filter(i => i.addonType === 'community' && i.group !== 'admin');
%>
<% if (showAnnouncement) { %>
  <div class="announcement-banner">
    <div class="container">
      <span class="announcement-icon">&#128227;</span>
      <span class="announcement-text"><%= announcement.content %></span>
    </div>
  </div>
<% } %>
<nav class="nav">
  <div class="nav-inner container">
    <a href="/" class="nav-brand">Quest Planner</a>
    <% if (user) { %>
      <div class="nav-links">
        <% if (addonEnabled('sound-board')) { %>
        <button type="button" class="nav-sound-btn" id="nav-sound-btn" title="Sound Board" aria-label="Sound Board">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
        </button>
        <% } %>
        <div class="notif-wrapper" id="notif-wrapper">
          <button type="button" class="nav-bell" id="notif-bell" title="Notifications" aria-label="Notifications" aria-expanded="false" aria-haspopup="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="notif-badge" id="notif-badge" style="display:none;"></span>
          </button>
          <div class="notif-dropdown" id="notif-dropdown" style="display:none;">
            <div class="notif-dropdown-header">
              <span>Notifications</span>
              <button type="button" class="notif-mark-all-read" id="notif-mark-all-read" title="Mark all as read">Mark all read</button>
            </div>
            <div class="notif-list" id="notif-list">
              <div class="notif-empty">No notifications</div>
            </div>
          </div>
        </div>
        <span id="nav-clock" class="nav-clock"></span>
        <span class="nav-user">
          <% if (user.avatar) { %>
            <img src="/avatars/<%= user.avatar %>" alt="" class="avatar-tiny">
          <% } else { %>
            <span class="avatar-letter"><%= user.username.charAt(0).toUpperCase() %></span>
          <% } %>
          <%= user.username %>
        </span>
        <button type="button" class="hamburger-btn" id="hamburger-btn" title="Menu" aria-label="Navigation Menu" aria-expanded="false" aria-haspopup="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </button>
        <div class="hamburger-menu" id="hamburger-menu">
          <!-- CORE (top-level items) -->
          <a href="/" class="hamburger-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
            Sessions
          </a>
          <a href="/players" class="hamburger-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            All Players
          </a>

          <%# Addon main group items (Bulletin Board, Campaigns, etc.) %>
          <% for (const item of addonMain) { %>
            <a href="<%= item.href %>" class="hamburger-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- typeof navIcons !== 'undefined' && navIcons[item.icon] ? navIcons[item.icon] : '<circle cx="12" cy="12" r="10"></circle>' %></svg>
              <%= item.label %>
            </a>
          <% } %>

          <div class="hamburger-divider"></div>

          <%# TOOLS group (core + preinstalled addon items) %>
          <% const coreTools = [
            { label: 'The Vault', href: '/vault', svgContent: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path><path d="M8 7h8"></path><path d="M8 11h8"></path><path d="M8 15h5"></path>' }
          ]; %>
          <% if (addonTools.length > 0 || coreTools.length > 0) { %>
          <button type="button" class="hamburger-group-toggle" data-group="tools">
            <span class="hamburger-group-label">&#9874;&#65039; Tools</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hamburger-group-arrow"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="hamburger-group-content" data-group-content="tools">
            <% for (const item of addonTools) { %>
              <a href="<%= item.href %>" class="hamburger-item hamburger-item-nested">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- typeof navIcons !== 'undefined' && navIcons[item.icon] ? navIcons[item.icon] : '<circle cx="12" cy="12" r="10"></circle>' %></svg>
                <%= item.label %>
              </a>
            <% } %>
            <% for (const item of coreTools) { %>
              <a href="<%= item.href %>" class="hamburger-item hamburger-item-nested">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- item.svgContent %></svg>
                <%= item.label %>
              </a>
            <% } %>
          </div>
          <% } %>

          <% if (user.role === 'dm' || user.role === 'admin') { %>
          <%# DM ZONE group (core + preinstalled addon items) %>
          <% const coreDM = [
            { label: 'DM Tools', href: '/dm-tools', svgContent: '<rect x="2" y="2" width="20" height="20" rx="3"></rect><circle cx="8" cy="8" r="1.5" fill="currentColor"></circle><circle cx="16" cy="8" r="1.5" fill="currentColor"></circle><circle cx="8" cy="16" r="1.5" fill="currentColor"></circle><circle cx="16" cy="16" r="1.5" fill="currentColor"></circle><circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>' }
          ]; %>
          <% if (addonDMZone.length > 0 || coreDM.length > 0) { %>
          <button type="button" class="hamburger-group-toggle" data-group="dm">
            <span class="hamburger-group-label">&#127922; DM Zone</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hamburger-group-arrow"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="hamburger-group-content" data-group-content="dm">
            <% for (const item of coreDM) { %>
              <a href="<%= item.href %>" class="hamburger-item hamburger-item-nested">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- item.svgContent %></svg>
                <%= item.label %>
              </a>
            <% } %>
            <% for (const item of addonDMZone) { %>
              <a href="<%= item.href %>" class="hamburger-item hamburger-item-nested">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- typeof navIcons !== 'undefined' && navIcons[item.icon] ? navIcons[item.icon] : '<circle cx="12" cy="12" r="10"></circle>' %></svg>
                <%= item.label %>
              </a>
            <% } %>
          </div>
          <% } %>
          <% } %>

          <%# ADDONS group — only community addon nav items %>
          <% if (addonCommunity.length > 0) { %>
          <button type="button" class="hamburger-group-toggle" data-group="addons">
            <span class="hamburger-group-label">&#128268; Addons</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hamburger-group-arrow"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="hamburger-group-content" data-group-content="addons">
            <% for (const item of addonCommunity) { %>
              <a href="<%= item.href %>" class="hamburger-item hamburger-item-nested">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- typeof navIcons !== 'undefined' && navIcons[item.icon] ? navIcons[item.icon] : '<circle cx="12" cy="12" r="10"></circle>' %></svg>
                <%= item.label %>
              </a>
            <% } %>
          </div>
          <% } %>

          <% if (user.role === 'admin') { %>
          <!-- ADMIN -->
          <button type="button" class="hamburger-group-toggle" data-group="admin">
            <span class="hamburger-group-label">&#9881;&#65039; Admin</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hamburger-group-arrow"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="hamburger-group-content" data-group-content="admin">
            <a href="/admin/users" class="hamburger-item hamburger-item-nested">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              Guild Settings
            </a>
            <a href="/admin/addons" class="hamburger-item hamburger-item-nested">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect></svg>
              Addon Management
            </a>
            <% for (const item of addonAdmin) { %>
              <a href="<%= item.href %>" class="hamburger-item hamburger-item-nested">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- typeof navIcons !== 'undefined' && navIcons[item.icon] ? navIcons[item.icon] : '<circle cx="12" cy="12" r="10"></circle>' %></svg>
                <%= item.label %>
              </a>
            <% } %>
          </div>
          <% } %>

          <div class="hamburger-divider"></div>

          <!-- YOUR ACCOUNT -->
          <div class="hamburger-section-label">Your Account</div>
          <a href="/profile" class="hamburger-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Profile
          </a>
          <a href="/settings" class="hamburger-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            Settings
          </a>

          <div class="hamburger-divider"></div>

          <!-- MORE -->
          <a href="/pwa" class="hamburger-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
            Install App
          </a>
          <a href="https://questplanner.canny.io/" target="_blank" rel="noopener noreferrer" class="hamburger-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            Feedback
          </a>
          <form action="/logout" method="POST" class="hamburger-logout-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="hamburger-item hamburger-logout">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              Leave Tavern
            </button>
          </form>
        </div>
      </div>
      <script>window.__timeFormat = '<%= user.time_format || "24h" %>';</script>
    <% } %>
  </div>
</nav>
