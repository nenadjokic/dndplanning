<%- include('../partials/head', { pageTitle: 'Join the Guild' }) %>

<div class="auth-page">
  <div class="card auth-card">
    <h1>Join the Guild</h1>
    <p class="subtitle">Create your adventurer identity</p>
    <form action="/register" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="username">Choose a Name</label>
        <input type="text" id="username" name="username" required autofocus>
      </div>
      <div class="form-group">
        <label for="password">Secret Passphrase</label>
        <div class="password-toggle-wrap">
          <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
          <button type="button" class="password-toggle-btn" onclick="togglePassword('password', this)" aria-label="Show password">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          </button>
        </div>
      </div>
      <div class="form-group">
        <label for="confirm_password">Confirm Passphrase</label>
        <div class="password-toggle-wrap">
          <input type="password" id="confirm_password" name="confirm_password" required minlength="8" autocomplete="new-password">
          <button type="button" class="password-toggle-btn" onclick="togglePassword('confirm_password', this)" aria-label="Show password">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          </button>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Join the Guild</button>
    </form>
    <p class="auth-link">Already a member? <a href="/login">Enter the Tavern</a></p>
  </div>
</div>

<%- include('../partials/foot') %>
